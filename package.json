{
  "name": "celecdn",
  "version": "2.0.0",
  "description": "CeleCDN — fast, hardened CDN + versioned package registry (/dl/) with token API, metrics, tracing and optional Discord alerts",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun --hot index.ts",
