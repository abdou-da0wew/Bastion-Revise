# MongoDB connection string (required)
MONGODB_URI=mongodb://mongo:27017/bastion

# JWT signing secret (required, min 32 chars) — openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars

# Public URLs
NEXT_PUBLIC_BASTION_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=https://cdn.celestialb.cv

# Bastion CDN core bridge (server-only, never exposed to the browser)
CDN_INTERNAL_URL=http://cdn:3005
CDN_SERVICE_TOKEN=
# CDN_ADMIN_TOKEN=   # fallback if no scoped service token exists yet

# Comma-separated emails auto-promoted to superadmin on register
BASTION_SUPERADMIN_EMAILS=
