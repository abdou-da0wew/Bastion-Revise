# ── CeleCDN ─────────────────────────────────────────────────────────────
# Copy to .env and edit. EVERY value is validated at startup — a typo fails
# fast with a readable message instead of crash-looping.

# Server
CDN_PORT=3005
CDN_HOST=0.0.0.0
CDN_BIND=127.0.0.1:3005
NODE_ENV=production

# Storage (in Docker these are forced to /opt/celecdn/* by compose)
CDN_ROOT_DIR=./public
CDN_PACKAGE_DIR=./packages
CDN_DATA_DIR=./data

# Admin / API — REQUIRED to use token management & uploads.
# Generate: openssl rand -hex 32   (this bootstrap token is a virtual admin; never stored on disk)
CDN_ADMIN_TOKEN=
CDN_API_ENABLED=true

# Rate limiting & proxies
CDN_RATE_LIMIT_ENABLED=true
CDN_RATE_LIMIT_MAX=1000
CDN_RATE_LIMIT_AUTH_MAX=60
# Leave false unless the origin is ONLY reachable via your proxy. To trust
# Cloudflare, pass its IP ranges, e.g. CDN_TRUST_PROXY=173.245.48.0/20,103.21.244.0/22
CDN_TRUST_PROXY=false

# CORS (comma-separated origins; '*' cannot be combined with credentials)
CDN_CORS_ORIGIN=*
CDN_CORS_CREDENTIALS=false

# Limits & streaming
CDN_MAX_FILE_SIZE=524288000
CDN_MAX_UPLOAD_SIZE=1073741824
CDN_MAX_STREAMS=128

# Compression
CDN_COMPRESSION_ENABLED=true
CDN_COMPRESSION_THRESHOLD=1024

# Logging / metrics
CDN_LOG_LEVEL=info
CDN_LOG_PRETTY=false
CDN_METRICS_ENABLED=true
CDN_METRICS_PUBLIC=false

# Discord webhooks — OFF by default. Set both to enable.
WEBHOOK_ENABLED=false
DISCORD_WEBHOOK_URL=
WEBHOOK_EVENTS=server.start,server.error,upload,file.delete,token.create,token.revoke,auth.failure,rate.limit
WEBHOOK_THROTTLE_MS=60000
WEBHOOK_USERNAME=CeleCDN

# Cloudflare Tunnel (only for the compose "tunnel" profile)
TUNNEL_TOKEN=
