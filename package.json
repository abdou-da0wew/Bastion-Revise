    "fastify": "^5.12.7",
    "mime-types": "^3.0.2"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.6.6",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  }
